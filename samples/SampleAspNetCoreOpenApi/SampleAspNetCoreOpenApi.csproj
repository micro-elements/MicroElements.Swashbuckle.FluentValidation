<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <!-- Issue #236 / ADR-008: this multi-targeted sample generates its build-time documents through the
         explicit Phase 3 commands (dotnet msbuild -target:Build,GenerateOpenApiDocuments -p:TargetFramework=net11.0),
         not through the automatic outer-build hook, which would run generation on the FIRST TFM (net9.0)
         and fail because the ApiDescription.Server package is referenced on net11.0 only.
         The explicit target is unaffected by this property — it only disables the automatic hook. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <!-- Issue #236: build-time document generation (net11.0 only — the generation commands below
         target net11.0; net9/net10 sample builds must not restore the RC-wave package). -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MicroElements.AspNetCore.OpenApi.FluentValidation\MicroElements.AspNetCore.OpenApi.FluentValidation.csproj" />
  </ItemGroup>

</Project>
