<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <Description>Swagger ISchemaFilter that uses FluentValidation validators instead System.ComponentModel based attributes.</Description>
    <PackageTags>swagger swashbuckle FluentValidation aspnetcore</PackageTags>
  </PropertyGroup>

  <!-- OPENAPI_V2 = the modern code shape; tested family: Microsoft.OpenApi 2.x (net10) and 3.x (net11). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">
    <DefineConstants>$(DefineConstants);OPENAPI_V2</DefineConstants>
  </PropertyGroup>

  <Import Project="..\common.props" />

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- 10.2.1 pulls patched Microsoft.OpenApi >= 2.7.5 (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451). See issue #220. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.1" />
  </ItemGroup>

  <!-- EXPERIMENT (experiment/issue-236-swash11-openapi32): Swashbuckle 11 preview from PR #3786
       (Microsoft.OpenApi 3.x). Exact pinned MyGet build; experiment-only, not for stable release. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.0-pr.3786.3260" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.0-pr.3786.3260" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="8.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroElements.OpenApi.FluentValidation\MicroElements.OpenApi.FluentValidation.csproj" />
  </ItemGroup>

</Project>