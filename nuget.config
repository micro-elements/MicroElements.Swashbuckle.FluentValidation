<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENT-ONLY (experiment/issue-236-swash11-openapi32): adds the Swashbuckle PR #3786
     MyGet preview feed for the Swashbuckle 11 / Microsoft.OpenApi 3.x compatibility experiment.
     Not intended for merge; remove before adopting anything from this branch. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="myget-domaindrivendev" value="https://www.myget.org/F/domaindrivendev/api/v3/index.json" />
  </packageSources>
  <!-- Standard source mapping: everything except Swashbuckle.* resolves from nuget.org only;
       Swashbuckle.* (both the stable 8.x/10.x and the preview 11 builds) may come from either source. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Swashbuckle.*" />
    </packageSource>
    <packageSource key="myget-domaindrivendev">
      <package pattern="Swashbuckle.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
